<%- include("partials/header") %>

<section class="categories-section page-container">
  <h2 class="page-title">Categories</h2>

  <!--  CREATE BUTTON -->
  <a href="/categories/new-category">Create New Category</a>

  <ul class="category-list">
    <% categories.forEach(category => { %>
      <li>
        <a href="/categories/<%= category.id %>">
          <%= category.name %>
        </a>

        |
        <a href="/categories/edit-category/<%= category.id %>">Edit</a>
      </li>
    <% }) %>
  </ul>
</section>

<%- include("partials/footer") %>