<%- include("partials/header") %>

<section class="hero">
  <div class="hero-images">
    <img
      src="/images/community-volunteer.jpg"
      alt="Community volunteers working together"
      class="hero-image"
    >

    <img
      src="/images/cleanups.jpg"
      alt="People participating in a community cleanup"
      class="hero-image"
    >
  </div>

  <h2>Welcome to the Community Service Portal</h2>

  <p>
    Explore partner organizations, discover service projects, and browse categories
    to find meaningful volunteer opportunities in your community.
  </p>

  <div class="hero-links">
    <a href="/organizations" class="btn">View Organizations</a>
    <a href="/projects" class="btn">Browse Projects</a>
    <a href="/categories" class="btn">Explore Categories</a>
  </div>
</section>

<section class="featured">
  <h3>Get Involved</h3>

  <div class="card-grid">

    <div class="card">
      <img src="/images/volunteer1.jpg" alt="Volunteering activity">
      <h3>Volunteer Opportunities</h3>
      <p>Join projects that match your interests and make a difference.</p>
      <a href="/projects">See Projects</a>
    </div>

    <div class="card">
      <img src="/images/organization.jpg" alt="Community organization">
      <h3>Partner Organizations</h3>
      <p>Work with trusted organizations serving your community.</p>
      <a href="/organizations">View Organizations</a>
    </div>

    <div class="card">
      <img src="/images/categories.jpg" alt="Service categories">
      <h3>Browse by Category</h3>
      <p>Find projects based on cause: education, health, environment, and more.</p>
      <a href="/categories">Explore Categories</a>
    </div>

  </div>
</section>

<%- include("partials/footer") %>