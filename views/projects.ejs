<%- include("partials/header") %>

<section class="projects-page">
  <h2>Service Projects</h2>

  <!-- CREATE BUTTON -->
  <a href="/projects/new">+ Create Project</a>

  <ul class="project-links">
    <% projects.forEach(p => { %>
      <li>
        <a href="/projects/<%= p.id %>"><%= p.name %></a>

        | <a href="/projects/edit/<%= p.id %>">Edit</a>

        <!-- CATEGORY ASSIGNMENT LINK -->
        | <a href="/projects/<%= p.id %>/categories">Categories</a>

        <!-- JOIN PROJECT BUTTON -->
        | <form action="/projects/<%= p.id %>/join" method="POST" style="display:inline;">
            <button type="submit">Join Project</button>
          </form>

        <!-- DELETE -->
        <form method="POST" action="/projects/delete/<%= p.id %>" style="display:inline;">
          <button type="submit">Delete</button>
        </form>
      </li>
    <% }) %>
  </ul>
</section>

<%- include("partials/footer") %>